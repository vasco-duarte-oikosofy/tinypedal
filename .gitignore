# ignore list

/brandlogo/
/deltabest/
/dist/
/dist/TinyPedal/
/settings/
/trackmap/

__pycache__/


# pipenv stuff
Pipfile
Pipfile.lock

# pylint stuff
pylintrc

# local config file
*.json
*.csv
*.fuel

# random file
test*.py
*.7z
*.zip
*.log
*.db

# Turn name label data ships with the package (generated by lap-telemetry's
# dev/scripts/export_turn_labels_for_tinypedal.py). Must come after the *.json
# rule above, otherwise the negation is ignored.
!/tinypedal/data/turn_labels/*.json
# Turn label tests live in the repo (they run headless, see CLAUDE.md)
!/tests/test_turn_labels.py
!/tests/test_turn_labels_render.py
!/tests/test_track_map_widget_labels.py
